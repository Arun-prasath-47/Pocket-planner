# Pocket Planner environment variables
# Copy to .env.local and fill in your own values.

# VITE_GEMINI_API_KEY: Optional. Enables Gemini AI parsing (voice/text quick-log)
# and the Financial Copilot. Without it the app falls back to offline parsing.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: Optional.
# When left unset or as placeholders, the app runs fully offline with a
# localStorage-backed mock database (great for local development and demos).
VITE_SUPABASE_URL="https://placeholder.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="placeholder-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
