# Pocket Planner environment variables
# Copy to .env.local and fill in your own values.

# --- Supabase (REQUIRED to launch for real users) ---
# 1. Create a free project at https://supabase.com
# 2. Run supabase/migrations/0001_init.sql in the project's SQL Editor
#    (creates all tables, security rules, and auto-provisions new users).
#    Then also run supabase/migrations/0002_launch_hardening.sql (adds the
#    pre-launch security hardening; safe to run at any time).
# 3. Set these two variables:
#    - VITE_SUPABASE_URL = your project URL (Settings -> API -> Project URL)
#    - VITE_SUPABASE_PUBLISHABLE_KEY = Settings -> API -> anon/publishable key
# When these are unset or placeholders, the app runs fully offline using a
# localStorage mock database (local development/demos only — data is not shared
# across devices and can be lost if browser storage is cleared).
VITE_SUPABASE_URL="https://placeholder.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="placeholder-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
